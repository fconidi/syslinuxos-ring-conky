-- Auto-scaling: rileva la risoluzione e dimensiona la finestra in proporzione.
-- rc/scale.lua ritorna il fattore rispetto al progetto 1920x1080 (finestra 1240x720).
-- Il launcher fa `cd /opt/Sys-ring-conky/`, quindi il path relativo e' valido.
local scale = dofile("rc/scale.lua")
SCALE = scale   -- condiviso con start.lua (stesso lua_State di conky)

conky.config = {
    minimum_height = math.floor(720 * scale),
    minimum_width  = math.floor(1240 * scale),
    gap_y          = math.floor(170 * scale),
    gap_x = 2,
    alignment = 'middle_middle',
    lua_load = "settings.lua start.lua",
    lua_draw_hook_pre = "main",
    text_buffer_size = 2048,
    double_buffer = true,
    background = true,
    update_interval = 1,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'normal',
    own_window_transparent = true,
    own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    use_xft = true,
    override_utf8_locale = true,
}

conky.text = [[]]
